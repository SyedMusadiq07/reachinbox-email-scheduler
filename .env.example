# PostgreSQL (Neon)
DATABASE_URL=""
DIRECT_URL=""

# Redis for BullMQ (local Docker)
REDIS_URL="redis://localhost:6379"

# Elasticsearch (local Docker)
ELASTICSEARCH_URL="http://localhost:9200"

# App
BACKEND_PORT="4000"
FRONTEND_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"
SESSION_MAX_AGE_MS="604800000"
SESSION_COOKIE_SAME_SITE="lax"
CREDENTIAL_ENCRYPTION_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# Slack OAuth
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:4000/api/integrations/slack/callback"
SLACK_STATE_SECRET="replace-with-a-random-secret-at-least-32-characters"

# BullMQ worker
WORKER_CONCURRENCY="10"
SEARCH_INDEX_WORKER_CONCURRENCY="5"
EMAIL_JOB_ATTEMPTS="3"
EMAIL_RETRY_BACKOFF_MS="5000"
EMAIL_DELIVERY_LOCK_TTL_MS="900000"
MIN_EMAIL_DELAY_MS="2000"
MAX_EMAILS_PER_HOUR_PER_SENDER="200"

# Ethereal
ETHEREAL_HOST="smtp.ethereal.email"
ETHEREAL_PORT="587"
# Account values will be added after Ethereal setup.
