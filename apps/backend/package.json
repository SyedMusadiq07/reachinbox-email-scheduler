{
    "name": "@reachinbox/backend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "dev:api": "tsx watch src/index.ts",
        "dev:worker": "tsx watch src/worker.ts",
        "build": "prisma generate && tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "start:worker": "node dist/worker.js",
        "worker": "tsx src/worker.ts",
        "lint": "eslint src --ext .ts",
        "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:verify": "tsx scripts/verify-database.ts",
        "redis:verify": "tsx scripts/verify-redis.ts",
        "queue:test": "tsx scripts/enqueue-test-job.ts",
        "queue:persistence:enqueue": "tsx scripts/enqueue-persistence-test.ts",
        "queue:persistence:inspect": "tsx scripts/inspect-test-job.ts",
        "db:validate": "prisma validate",
        "ethereal:seed": "tsx scripts/seed-ethereal.ts",
        "queue:replay-sent": "tsx scripts/replay-sent-email.ts",
        "phase4:verify-lock-and-email-filters": "tsx scripts/verify-phase4-final-fixes.ts",
        "phase5:verify-rate-limit": "tsx scripts/verify-phase5-rate-limit.ts",
        "phase5:verify-reschedule": "tsx scripts/verify-phase5-reschedule.ts",
        "phase5:verify-bullmq-delay": "tsx scripts/verify-phase5-bullmq-delay.ts",
        "phase5:verify-load": "tsx scripts/verify-phase5-load.ts",
        "phase5:verify-restart": "tsx scripts/verify-phase5-restart.ts",
        "search:init": "tsx scripts/init-elasticsearch.ts",
        "search:reindex": "tsx scripts/reindex-emails.ts",
        "search:verify": "tsx scripts/verify-elasticsearch.ts",
        "auth:verify": "tsx scripts/verify-google-auth.ts"
    },
    "dependencies": {
        "@bull-board/api": "9.10.1",
        "@bull-board/express": "9.10.1",
        "@elastic/elasticsearch": "9.5.1",
        "@prisma/adapter-neon": "7.10.0",
        "@prisma/client": "7.10.0",
        "bullmq": "6.3.9",
        "connect-redis": "10.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.2.1",
        "express-session": "1.19.0",
        "google-auth-library": "11.1.0",
        "ioredis": "6.0.0",
        "nodemailer": "10.0.10",
        "redis": "5.11.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/express-session": "1.19.0",
        "@types/node": "^22.20.4",
        "@types/nodemailer": "8.0.2",
        "eslint": "^9.39.5",
        "prisma": "7.10.0",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.1"
    }
}
